// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/back-end/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====================== ADMIN ======================
model Admin {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String // Hashed password
  avatar       String?
  phone        String?
  role         Role    @default(SUPER_ADMIN)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  lastLoginAt DateTime?
  isActive    Boolean   @default(false)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("admins")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// ====================== CONTESTANT ======================

model ContestantTransaction {
  id            String                 @id @default(cuid())
  name          String
  email         String
  phoneNumber   String?
  amount        Float?
  reference     String                 @unique
  paymentMethod String?
  status        TransactionStatus @default(PENDING) //Pending Ones User Initiate Payment Then Update Once Payment is Approved from Payment Gateway
  claimed        Boolean?               @default(false)
  formSent     Boolean?               @default(false)

  contestant Contestant?
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([reference])
}

model Contestant {
  id String @id @default(cuid())

  name   String
  email  String @unique
  gender Gender
  number Int    @default(1)
  status Status @default(PENDING)

  image String?
  phone String

  age                     Int
  state                   String
  country                 String
  occupation              String
  advocacy                String
  funFact                 String
  tribe                   String
  reference String @unique

  isVerified Boolean @default(false)

  stageName String?
  height    Float?
  weight    Float?
  bio       String?
  portfolio String?

  score Float?
  rank  Int?

  eventId               String
  event                 Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contestantTransaction ContestantTransaction @relation(fields: [reference], references: [reference], onDelete: Cascade)
  contestantCategories  ContestantCategories

  votes Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContestantCategories {
  MALE
  FEMALE
}

enum Gender {
  MALE
  FEMALE
}

enum Status {
  PENDING
  ACTIVE
  INACTIVE
}

// ====================== EVENT / PAGEANT ======================
model Event {
  id             String      @id @default(cuid())
  name           String
  description    String
  startDate      DateTime
  endDate        DateTime
  location       String
  contestantFee  Int
  status         EventStatus @default(UPCOMING)
  categories     String[]

  // --- CRITICAL DATES ---
  registrationOpenDate  DateTime?
  registrationCloseDate DateTime?
  auditionsDate         DateTime?
  preliminaryDate       DateTime?
  grandFinaleDate       DateTime?

  // --- ITINERARY SECTION CUSTOMIZATION ---
  itineraryTitle        String?   @default("FOUR DAYS OF EXCELLENCE") // e.g. "FOUR DAYS OF EXCELLENCE"

  // --- DASHBOARD CONTROLS ---
  isRegistrationOpen   Boolean   @default(false) 
  isTicketsOpen        Boolean   @default(false) 
  isVotingOpen         Boolean   @default(false) 
  isContestantsVisible Boolean   @default(false) 

  // --- RELATIONS ---
  itineraryDays          EventItineraryDay[]
  ticketTransaction      TicketTransaction[]
  votes                  Vote[]
  sponsors               Sponsor[]
  ticketTypes            TicketType[]
  contestants            Contestant[]
  contestantTransactions ContestantTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- EVENT ITINERARY MODEL ---
model EventItineraryDay {
  id          String   @id @default(cuid())
  dayNumber   Int      // e.g., 1, 2, 3, 4
  title       String   // e.g., "ARRIVAL & WELCOME RECEPTION"
  date        DateTime // e.g., 2027-05-17
  
  // Store array of schedule objects: [{ time: "10:00 AM", title: "Contestant Check-In & Accreditation" }]
  schedule    Json     

  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, dayNumber])
  @@map("event_itinerary_days")
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model TicketType {
  id                String              @id @default(cuid())
  name              String
  price             Float
  capacity          Int?
  benefits          String[]
  eventId           String
  event             Event               @relation(fields: [eventId], references: [id])
  ticketTransaction TicketTransaction[]
}

model Vote {
  id           String @id @default(cuid())
  contestantId String
  eventId      String
  count        Int

  contestant Contestant @relation(fields: [contestantId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contestantId, eventId])
}

// ====================== TICKETS & SPONSORS ======================
model TicketTransaction {
  id            String                 @id @default(cuid())
  name          String
  email         String
  phoneNumber   String?
  eventId       String
  ticketTypeId  String
  amount        Float?
  quantity      Int                    @default(1)
  total         Float
  reference     String                 @unique
  paymentMethod String?
  status        TransactionStatus @default(PENDING) //Pending Ones User Initiat Payment Then Update Once Payment is Approved from Payment Gateway
  clamed        Boolean?               @default(false)

  tickets Ticket[]

  tickettype TicketType @relation(fields: [ticketTypeId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([eventId])
  @@index([reference])
}

enum TransactionStatus {
  ABANDONED
  FAILED
  ONGOING
  PENDING
  PROCESSING
  QUEUED
  REVERSED
  SUCCESS
  USED
}

model Ticket {
  id                  String            @id @default(cuid())
  reference           String
  status              TicketStatus      @default(PENDING)
  ticketTransactionId String
  ticketTransaction   TicketTransaction @relation(fields: [ticketTransactionId], references: [id])
}

enum TicketStatus {
  PENDING
  SEND
  USED
}

model Sponsor {
  id          String      @id @default(cuid())
  name        String
  logo        String?
  website     String?
  description String?
  tier        SponsorTier

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@index([eventId])
}

enum SponsorTier {
  GOLD
  SILVER
  BRONZE
}

// ====================== SUBSCRIPTION ======================
model Subscription {
  id           String   @id @default(cuid())
  email        String
  subscribedAt DateTime @default(now())

  @@unique([email])
}

// ====================== RefreshToken ======================
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}


model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  method       String
  path         String
  statusCode   Int?     @default(0)
  response     Json?
  pending      Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("idempotency_keys")
}