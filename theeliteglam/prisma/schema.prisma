// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/back-end/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================
// ENUMS
// ======================

enum PaymentPurpose {
  TICKET
  CONTESTANT
}

enum PaymentGateway {
  PAYSTACK
  OPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketStatus {
  PENDING
  SENT
  USED
}

enum Gender {
  MALE
  FEMALE
}

enum Status {
  PENDING
  ACTIVE
  INACTIVE
}

enum ContestantCategories {
  MALE
  FEMALE
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum SponsorTier {
  GOLD
  SILVER
  BRONZE
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// ======================
// EVENT
// ======================

model Event {
  id            String      @id @default(cuid())
  name          String
  description   String
  startDate     DateTime
  endDate       DateTime
  location      String
  contestantFee Decimal     @db.Decimal(12, 2)
  status        EventStatus @default(UPCOMING)
  categories    String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ticketTypes         TicketType[]
  tickets             Ticket[]
  contestants         Contestant[]
  paymentTransactions PaymentTransaction[]
  votes               Vote[]
  sponsors            Sponsor[]
}

// ======================
// TICKET TYPE
// ======================

model TicketType {
  id       String   @id @default(cuid())
  name     String
  price    Decimal  @db.Decimal(12, 2)
  capacity Int?
  benefits String[]
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets  Ticket[]
}

// ======================
// PAYMENT TRANSACTION (SINGLE SOURCE OF TRUTH)
// ======================

model PaymentTransaction {
  id                String            @id @default(cuid())
  reference         String            @unique
  purpose           PaymentPurpose
  gateway           PaymentGateway
  gatewayReference  String?
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("NGN")
  status            PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  email             String
  phoneNumber       String?
  name              String?
  eventId           String
  ticketTypeId      String?
  quantity          Int?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  contestant Contestant?

  @@index([email])
  @@index([eventId])
  @@index([status])
  @@index([purpose])
}

// ======================
// TICKET (fulfillment only)
// ======================

model Ticket {
  id                   String             @id @default(cuid())
  reference            String
  status               TicketStatus       @default(PENDING)
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  ticket               String             @unique
  ticketTypeId         String
  ticketType           TicketType         @relation(fields: [ticketTypeId], references: [id])
  eventId              String
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([paymentTransactionId, reference]) // real protection
  @@index([paymentTransactionId])
  @@index([eventId])
  @@index([reference])
}

// ======================
// CONTESTANT (fulfillment only)
// ======================

model Contestant {
  id                   String                @id @default(cuid())
  name                 String
  email                String
  gender               Gender
  number               Int                   @default(1)
  status               Status                @default(PENDING)
  image                String?
  phone                String
  age                  Int?
  state                String?
  country              String?
  occupation           String?
  advocacy             String?
  funFact              String?
  tribe                String?
  reference            String                @unique // same as PaymentTransaction.reference
  isVerified           Boolean               @default(false)
  stageName            String?
  height               Float?
  weight               Float?
  bio                  String?
  portfolio            String?
  score                Float?
  rank                 Int?
  eventId              String
  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentTransactionId String                @unique
  paymentTransaction   PaymentTransaction    @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  contestantCategories ContestantCategories?
  votes                Vote[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([email])
  @@index([reference])
  @@index([eventId])
}

// ======================
// VOTE
// ======================

model Vote {
  id           String     @id @default(cuid())
  contestantId String
  eventId      String
  count        Int
  contestant   Contestant @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([contestantId, eventId])
}

// ======================
// SPONSOR
// ======================

model Sponsor {
  id          String      @id @default(cuid())
  name        String
  logo        String?
  website     String?
  description String?
  tier        SponsorTier
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([eventId])
}

// ======================
// ADMIN + AUTH (unchanged)
// ======================

model Admin {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  passwordHash    String
  avatar          String?
  phone           String?
  role            Role           @default(SUPER_ADMIN)
  emailVerified   Boolean        @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  isActive        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]

  @@map("admins")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Subscription {
  id           String   @id @default(cuid())
  email        String
  subscribedAt DateTime @default(now())

  @@unique([email])
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique
  method     String
  path       String
  statusCode Int      @default(0) // 0 = pending
  response   Json?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}
